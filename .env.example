# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Public base URL of this server (used for signed receipt links)
PUBLIC_BASE_URL=http://localhost:5000

# Kill switch: set to "true" only once payment authorization is deployed
PAYMENTS_ENABLED=false

# Database
DATABASE_URL=
DIRECT_URL=

# Redis
REDIS_URL=

# 9PSB (must be https:// in production). PSB_ENV=sandbox|production
PSB_ENV=sandbox
PSB_BASE_URL=
PSB_VAS_BASE_URL=
PSB_IDENTITY_BASE_URL=
PSB_WAAS_USERNAME=
PSB_WAAS_PASSWORD=
PSB_WAAS_CLIENT_ID=
PSB_WAAS_CLIENT_SECRET=
PSB_VAS_API_KEY=
PSB_VAS_SECRET_KEY=
PSB_VAS_USERNAME=
PSB_VAS_PASSWORD=
# 9PSB -> us webhook basic auth
WEBHOOK_USERNAME=
WEBHOOK_PASSWORD=
# Optional comma-separated IP allowlist for the 9PSB webhook
PSB_WEBHOOK_IPS=

# LLM
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_API_MODEL=
OPENAI_API_BASE_URL=
GROQ_API_KEY=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_REGISTRATION_FLOW_ID=
WHATSAPP_PAYMENT_FLOW_ID=
# Path to the Flow RSA private key (PEM, outside the repo), and its passphrase if encrypted
WHATSAPP_FLOW_PRIVATE_KEY_PATH=
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=

# Security — generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
ENCRYPTION_KEY=
# HMAC key for blind indexes, flow tokens and signed receipt links
HMAC_KEY=
# Admin API key for /api/admin/*, and optional IP allowlist
ADMIN_API_KEY=
ADMIN_IPS=
